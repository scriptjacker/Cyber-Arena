# ---------------------------------------------------------------------------
# Chetna configuration. Copy to .env and run `pnpm chetna keys init`.
# ---------------------------------------------------------------------------

# offline | live
#   offline => policy gate G7 refuses any non-loopback mail transport and any
#              recipient domain outside the reserved test TLDs (.test/.example/
#              .invalid/localhost). The mode is part of the signed campaign
#              scope, so it cannot be flipped mid-campaign.
CHETNA_MODE=offline

# SQLite for the offline demo. Postgres for production:
#   DATABASE_URL="postgresql://user:pass@host:5432/chetna"
DATABASE_URL="file:./dev.db"

# Local SMTP sink (services/mailsink). MUST stay on loopback in offline mode.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# Ports 3000/3001 are commonly held by WSL port relays (wslrelay.exe), which
# accept the connection and then return an empty reply. 4000/4001 avoid that.
# These must match the -p flags in apps/*/package.json.
CONSOLE_URL=http://localhost:4000
SIM_URL=http://localhost:4001

# Generated by `pnpm chetna keys init` — never commit real values.
SESSION_SECRET=
TOKEN_HMAC_KEY=

# AI provider: offline (deterministic, no network) | anthropic
CHETNA_AI_PROVIDER=offline
ANTHROPIC_API_KEY=

# Privacy / policy knobs (changes are audit-logged)
KANON_K=5
COOLDOWN_DAYS=30
NEW_JOINER_GRACE_DAYS=30
